// CSMJU Campus Activity Tracker - OWN database schema.
//
// Scope (ตัดสินแล้วโดย PL/ทีม): ระบบแจ้งเตือน/ประกาศกิจกรรมเท่านั้น
// ไม่มีการลงทะเบียน เช็คชื่อ หรือคำนวณชั่วโมงกิจกรรมในระบบนี้
// ปุ่ม "สมัคร" แค่พาไปหน้าแบบฟอร์มภายนอกที่ผู้จัดกิจกรรมเตรียมไว้เอง
//
// Naming follows the CSMJU2030 Subsystem Standard: PostgreSQL tables are plural
// snake_case and every column is snake_case through @map, while Prisma/TypeScript
// field names stay camelCase.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Activity {
  id String @id @default(uuid())

  title       String
  description String?
  location    String?

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  /// ลิงก์ไปหน้าสมัคร/แบบฟอร์มของผู้จัดกิจกรรม (ภายนอกระบบนี้)
  registrationUrl      String?   @map("registration_url")
  registrationDeadline DateTime? @map("registration_deadline")

  status ActivityStatus @default(DRAFT)

  /// Core Hub `sub` ของแอดมินที่โพส - ไม่ใช่ local account
  createdByCoreUserId String @map("created_by_core_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, startsAt])
  @@map("activities")
}